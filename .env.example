COGNITO_DOMAIN=https://<prefix>.auth.<region>.amazoncognito.com
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=
# Leave empty for public clients
COGNITO_APP_CLIENT_SECRET=
# Comma-separated Cognito identity provider names (as configured in the user pool)
COGNITO_IDP_NAMES=Auth0-Poc,Google,Okta
